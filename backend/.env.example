PORT=5000
JWT_SECRET=your-jwt-secret-change-in-production

# Allowed browser origins (comma-separated, no wildcards in production)
CORS_ORIGIN=http://localhost:5173

# Administrator account (separate from normal user registration)
# Wrap values in double quotes if they contain # or other special characters.
ADMIN_EMAIL=admin@guardup.local
ADMIN_PASSWORD="change-this-secure-password"
ADMIN_JWT_EXPIRE=8h

# Optional display name
ADMIN_FIRST_NAME=GuardUP
ADMIN_LAST_NAME=Administrator
